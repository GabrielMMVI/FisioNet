<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FIsioNet.Controls"
             xmlns:models="clr-namespace:FIsioNet.Models"
             xmlns:views="clr-namespace:FIsioNet.Views"
             x:Class="FIsioNet.Views.CursosPage"
             x:DataType="views:CursosPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}"
             Title="Cursos">

    <ContentPage.Resources>
        <Color x:Key="Ink">#1B2B22</Color>
        <Color x:Key="Muted">#5F7A6A</Color>
        <Color x:Key="ChipBg">#EEF2EF</Color>
        <Color x:Key="Star">#F2A01E</Color>
        <Color x:Key="PageBg">#F7F8F7</Color>
    </ContentPage.Resources>

    <!-- Conteúdo rolável (*) + barra inferior fixa (Auto) -->
    <Grid RowDefinitions="*, Auto" BackgroundColor="{StaticResource PageBg}">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- ===== Cabeçalho ===== -->
                <VerticalStackLayout BackgroundColor="{StaticResource Background}"
                                     Padding="24,48,24,16" Spacing="4">
                    <Label Text="FISIOLINK ACADEMY"
                           FontSize="13" FontAttributes="Bold" CharacterSpacing="2"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Cursos para Fisioterapeutas"
                           FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="{Binding SubtituloCabecalho}"
                           FontSize="15" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>

                <!-- ===== Filtros por categoria ===== -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            BackgroundColor="{StaticResource Background}">
                    <HorizontalStackLayout x:Name="ChipsContainer"
                                           Spacing="10" Padding="24,8,24,16" />
                </ScrollView>
                <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                <!-- ===== Curso em destaque ===== -->
                <VerticalStackLayout Padding="24,20,24,0" Spacing="14"
                                     IsVisible="{Binding TemDestaque}">
                    <Label FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Ink}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="⚡  " TextColor="{StaticResource Primary}" />
                                <Span Text="CURSO EM DESTAQUE" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Border x:DataType="models:Curso"
                            BindingContext="{Binding CursoDestaque, x:DataType=views:CursosPage}"
                            BackgroundColor="{StaticResource Background}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 18"
                            Padding="0">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.08" Radius="16" Offset="0,4" />
                        </Border.Shadow>

                        <VerticalStackLayout>
                            <!-- Capa com selo, nível, play e data -->
                            <Grid HeightRequest="230">
                                <Image Source="{Binding ImagemCapa}" Aspect="AspectFill" />
                                <BoxView>
                                    <BoxView.Background>
                                        <LinearGradientBrush EndPoint="0,1">
                                            <GradientStop Color="#33000000" Offset="0.0" />
                                            <GradientStop Color="Transparent" Offset="0.4" />
                                            <GradientStop Color="#66000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>

                                <HorizontalStackLayout Spacing="8" Margin="14"
                                                       VerticalOptions="Start" HorizontalOptions="Start">
                                    <Border BackgroundColor="{StaticResource Primary}" Stroke="Transparent"
                                            StrokeShape="RoundRectangle 4" Padding="10,4"
                                            IsVisible="{Binding TemSelo}">
                                        <Label Text="{Binding Selo}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                    <Border BackgroundColor="#E6FFFFFF" Stroke="Transparent"
                                            StrokeShape="RoundRectangle 4" Padding="10,4">
                                        <Label Text="{Binding Nivel}" FontSize="12" TextColor="{StaticResource Ink}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Botão play -->
                                <Border BackgroundColor="{StaticResource Primary}" Stroke="Transparent"
                                        StrokeShape="RoundRectangle 30"
                                        WidthRequest="60" HeightRequest="60"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="BtnPreview_Tapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="▶" FontSize="24" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           Margin="4,0,0,0" />
                                </Border>

                                <Label Text="{Binding AtualizadoTexto}" FontSize="13" TextColor="White"
                                       HorizontalOptions="End" VerticalOptions="End" Margin="14" />
                            </Grid>

                            <!-- Informações -->
                            <VerticalStackLayout Padding="20,18,20,20" Spacing="12">
                                <Label Text="{Binding Titulo}" FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />

                                <HorizontalStackLayout Spacing="10">
                                    <Border StrokeShape="RoundRectangle 16" Stroke="Transparent"
                                            WidthRequest="32" HeightRequest="32"
                                            BackgroundColor="{StaticResource PrimaryLight}">
                                        <Image Source="{Binding InstrutorAvatar}" Aspect="AspectFill" />
                                    </Border>
                                    <Label Text="{Binding InstrutorNome}" FontSize="15"
                                           TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding NotaTexto}" FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource Star}" VerticalOptions="Center" />
                                    <Label Text="{Binding Estrelas}" FontSize="16"
                                           TextColor="{StaticResource Star}" VerticalOptions="Center" />
                                    <Label Text="{Binding AvaliacoesTexto}" FontSize="13"
                                           TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                    <Label Text="{Binding AlunosTexto, StringFormat='👥 {0}'}" FontSize="13"
                                           TextColor="{StaticResource Muted}" VerticalOptions="Center"
                                           Margin="6,0,0,0" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="18">
                                    <Label Text="{Binding CargaHoraria, StringFormat='🕒 {0}'}" FontSize="14"
                                           TextColor="{StaticResource Muted}" />
                                    <Label Text="{Binding ModulosTexto, StringFormat='📖 {0}'}" FontSize="14"
                                           TextColor="{StaticResource Muted}" />
                                    <Label Text="🎖 Certificado" FontSize="14"
                                           TextColor="{StaticResource Muted}"
                                           IsVisible="{Binding TemCertificado}" />
                                </HorizontalStackLayout>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding PrecoTexto}" FontSize="28" FontAttributes="Bold"
                                                   TextColor="{StaticResource Ink}" />
                                            <Label Text="{Binding PrecoOriginalTexto}" FontSize="16"
                                                   TextColor="{StaticResource Gray300}"
                                                   TextDecorations="Strikethrough" VerticalOptions="Center"
                                                   IsVisible="{Binding TemDesconto}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding DescontoTexto}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               IsVisible="{Binding TemDesconto}" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1" Text="Comprar"
                                            FontSize="17" FontAttributes="Bold"
                                            BackgroundColor="{StaticResource Primary}" TextColor="White"
                                            CornerRadius="14" HeightRequest="56" Padding="28,0"
                                            CommandParameter="{Binding .}"
                                            Clicked="BtnComprar_Clicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ===== Todos os cursos ===== -->
                <Grid ColumnDefinitions="*, Auto" Padding="24,28,24,14">
                    <Label Grid.Column="0" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Ink}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="📖  " TextColor="{StaticResource Primary}" />
                                <Span Text="TODOS OS CURSOS" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Grid.Column="1" Text="{Binding ContagemLista}" FontSize="14"
                           TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                </Grid>

                <Label Text="Nenhum curso nesta categoria ainda."
                       Padding="24,0,24,24" FontSize="14" TextColor="{StaticResource Muted}"
                       IsVisible="{Binding ListaVazia}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CursosFiltrados}"
                                     Padding="24,0,24,24" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Curso">
                            <Border BackgroundColor="{StaticResource Background}"
                                    Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="0">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="12" Offset="0,3" />
                                </Border.Shadow>
                                <VerticalStackLayout>
                                    <Grid HeightRequest="160">
                                        <Image Source="{Binding ImagemCapa}" Aspect="AspectFill" />
                                        <BoxView>
                                            <BoxView.Background>
                                                <LinearGradientBrush EndPoint="0,1">
                                                    <GradientStop Color="#40000000" Offset="0.0" />
                                                    <GradientStop Color="Transparent" Offset="0.5" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <HorizontalStackLayout Spacing="8" Margin="14"
                                                               VerticalOptions="Start" HorizontalOptions="Start">
                                            <Border BackgroundColor="{StaticResource Star}" Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 4" Padding="10,4"
                                                    IsVisible="{Binding TemSelo}">
                                                <Label Text="{Binding Selo}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                            </Border>
                                            <Border BackgroundColor="#E6FFFFFF" Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 4" Padding="10,4">
                                                <Label Text="{Binding Nivel}" FontSize="12" TextColor="{StaticResource Ink}" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- Favoritar -->
                                        <Border BackgroundColor="#66000000" Stroke="Transparent"
                                                StrokeShape="RoundRectangle 18"
                                                WidthRequest="36" HeightRequest="36" Margin="12"
                                                HorizontalOptions="End" VerticalOptions="Start">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="BtnFavorito_Tapped"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding IconeFavorito}" FontSize="18" TextColor="White"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Padding="16,14,16,16" Spacing="8">
                                        <Label Text="{Binding Titulo}" FontSize="17" FontAttributes="Bold"
                                               TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding InstrutorNome}" FontSize="14"
                                               TextColor="{StaticResource Muted}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding NotaTexto}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource Star}" />
                                            <Label Text="{Binding Estrelas}" FontSize="14" TextColor="{StaticResource Star}" />
                                            <Label Text="{Binding AvaliacoesTexto}" FontSize="12"
                                                   TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label FontSize="13" TextColor="{StaticResource Muted}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="🕒 " />
                                                    <Span Text="{Binding CargaHoraria}" />
                                                    <Span Text="   ·   " />
                                                    <Span Text="{Binding ModulosTexto}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding PrecoTexto}" FontSize="20" FontAttributes="Bold"
                                                       TextColor="{StaticResource Ink}" />
                                                <Label Text="{Binding PrecoOriginalTexto}" FontSize="13"
                                                       TextColor="{StaticResource Gray300}"
                                                       TextDecorations="Strikethrough" VerticalOptions="Center"
                                                       IsVisible="{Binding TemDesconto}" />
                                            </HorizontalStackLayout>
                                            <Button Grid.Column="1" Text="Comprar"
                                                    FontSize="14" FontAttributes="Bold"
                                                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                                                    CornerRadius="12" HeightRequest="42" Padding="18,0"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="BtnComprar_Clicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de navegação inferior (componente único: Controls/BottomNavBar) -->
        <controls:BottomNavBar Grid.Row="1" AbaAtual="Cursos" />
    </Grid>
</ContentPage>
