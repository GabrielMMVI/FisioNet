<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FIsioNet.Controls"
             x:Class="FIsioNet.Views.AvisosPage"
             BackgroundColor="{StaticResource Background}"
             Title="Avisos">

    <Grid RowDefinitions="*,Auto">

        <!-- Bônus: deslizar para a direita também volta pro Feed -->
        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Right" Swiped="BtnVoltarFeed_Clicked" />
        </Grid.GestureRecognizers>

        <!-- Estado vazio: seção em desenvolvimento -->
        <VerticalStackLayout
            Grid.Row="0"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Padding="40,0"
            Spacing="16">

            <Border
                WidthRequest="72"
                HeightRequest="72"
                Padding="0"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource PrimaryLight}"
                HorizontalOptions="Center">
                <Label
                    Text="&#128276;"
                    FontSize="32"
                    TextColor="{StaticResource Primary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Text="Notificações"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Esta seção está em desenvolvimento. Use o botão abaixo para voltar ao feed."
                FontSize="14"
                TextColor="{StaticResource TextSecondary}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Button
                Text="Voltar ao Feed"
                Clicked="BtnVoltarFeed_Clicked"
                Margin="0,8,0,0"
                Padding="24,12"
                FontAttributes="Bold"
                CornerRadius="24"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource White}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

        <!-- Barra de navegação inferior (componente único: Controls/BottomNavBar) -->
        <controls:BottomNavBar Grid.Row="1" AbaAtual="" />

    </Grid>
    
</ContentPage>
