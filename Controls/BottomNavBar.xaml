<?xml version="1.0" encoding="utf-8" ?>
<!--
    Barra de navegação inferior ÚNICA do app.
    Uso em qualquer página:  <controls:BottomNavBar Grid.Row="1" AbaAtual="Feed" />
    Valores de AbaAtual: Feed, Cursos, Publicar, Simulados, Perfil (ou vazio = nenhuma ativa)
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FIsioNet.Controls.BottomNavBar">

    <Grid BackgroundColor="{StaticResource Background}"
          ColumnDefinitions="*,*,*,*,*"
          Padding="0,10,0,20">

        <BoxView Grid.ColumnSpan="5" HeightRequest="1" Color="{StaticResource Gray100}"
                 VerticalOptions="Start" Margin="0,-10,0,0" />

        <!-- Feed -->
        <VerticalStackLayout x:Name="TabFeed" Grid.Column="0" HorizontalOptions="Center" Spacing="4">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Tab_Tapped" CommandParameter="Feed" />
            </VerticalStackLayout.GestureRecognizers>
            <Image x:Name="IconFeed" Source="button_home.png" WidthRequest="24" HeightRequest="24" />
            <Label x:Name="LabelFeed" Text="Feed" FontSize="11" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Cursos -->
        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Tab_Tapped" CommandParameter="Cursos" />
            </VerticalStackLayout.GestureRecognizers>
            <Label x:Name="IconCursos" Text="🎓" FontSize="20" HeightRequest="24" HorizontalOptions="Center" />
            <Label x:Name="LabelCursos" Text="Cursos" FontSize="11" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Publicar (botão central) -->
        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4" Margin="0,-4,0,0">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Tab_Tapped" CommandParameter="Publicar" />
            </VerticalStackLayout.GestureRecognizers>
            <Border BackgroundColor="{StaticResource Primary}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 10" Padding="12,6" WidthRequest="48">
                <Image Source="button_newpost.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" />
            </Border>
            <Label x:Name="LabelPublicar" Text="Publicar" FontSize="11" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Simulados -->
        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Tab_Tapped" CommandParameter="Simulados" />
            </VerticalStackLayout.GestureRecognizers>
            <Label x:Name="IconSimulados" Text="📋" FontSize="20" HeightRequest="24" HorizontalOptions="Center" />
            <Label x:Name="LabelSimulados" Text="Simulados" FontSize="11" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Perfil -->
        <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="Tab_Tapped" CommandParameter="Perfil" />
            </VerticalStackLayout.GestureRecognizers>
            <Image x:Name="IconPerfil" Source="button_profile.png" WidthRequest="24" HeightRequest="24" />
            <Label x:Name="LabelPerfil" Text="Perfil" FontSize="11" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
